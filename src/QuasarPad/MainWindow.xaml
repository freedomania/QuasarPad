<Window x:Class="QuasarPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="QuasarPad"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}" Foreground="{DynamicResource MenuForeground}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click"/>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" Click="Replace_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Word Wrap" IsCheckable="True" IsChecked="True" Click="WordWrap_Click" Name="MenuWordWrap"/>
                <MenuItem Header="_Line Numbers" IsCheckable="True" IsChecked="True" Click="LineNumbers_Click" Name="MenuLineNumbers"/>
                <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True" Click="StatusBar_Click" Name="MenuStatusBar"/>
                <Separator/>
                <MenuItem Header="_Pure Mode" IsCheckable="True" IsChecked="True" Click="PureMode_Click" Name="MenuPureMode"/>
                <MenuItem Header="_Dark Mode" IsCheckable="True" Click="DarkMode_Click" Name="MenuDarkMode"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Markdown to HTML..." Click="MarkdownToHtml_Click"/>
                <MenuItem Header="_HTML Test..." Click="HtmlTest_Click"/>
                <MenuItem Header="Text Too_ls..." Click="TextTools_Click"/>
                <Separator/>
                <MenuItem Header="_JSON Format" Click="JsonFormat_Click"/>
                <MenuItem Header="Format _Text" Click="FormatText_Click"/>
                <MenuItem Header="_Reflow Paragraphs" Click="ReflowText_Click"/>
                <Separator/>
                <MenuItem Header="_Settings..." Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About QuasarPad" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="Open on _GitHub" Click="OpenGitHub_Click"/>
                <MenuItem Header="_Support the Project..." Click="Support_Click"/>
                <MenuItem Header="_Become a Supporter..." Click="Supporter_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <avalonedit:TextEditor
                x:Name="MainEditor"
                Grid.Row="0"
                FontFamily="Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                WordWrap="True"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource EditorBackground}"
                Foreground="{DynamicResource EditorForeground}"
                LineNumbersForeground="{DynamicResource MenuForeground}"
                TextChanged="MainEditor_TextChanged"/>

            <StatusBar x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource StatusBarBackground}">
                <StatusBarItem>
                    <TextBlock x:Name="StatusLineCol" Text="Ln 1, Col 1" Foreground="White"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusEncoding" Text="UTF-8" Foreground="White"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="StatusMode" Text="Pure Mode" Foreground="White"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusCharCount" Text="0 characters" Foreground="White"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>
