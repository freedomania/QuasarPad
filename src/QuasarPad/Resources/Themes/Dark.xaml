    <SolidColorBrush x:Key="EditorForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="MenuForeground" Color="#F0F0F0"/>
