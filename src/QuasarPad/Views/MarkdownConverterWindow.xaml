<Window x:Class="QuasarPad.Views.MarkdownConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown to HTML - QuasarPad"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}">
            <Button Content="Copy Full HTML" Click="CopyFullHtml_Click" Margin="4" Padding="10,4"/>
            <Button Content="Copy Body Only" Click="CopyBodyOnly_Click" Margin="4" Padding="10,4"/>
            <Button Content="Export .html" Click="ExportHtml_Click" Margin="4" Padding="10,4"/>
            <Separator/>
            <Button Content="Clear" Click="Clear_Click" Margin="4" Padding="10,4"/>
            <Button Content="Load from Editor" Click="LoadFromEditor_Click" Margin="4" Padding="10,4"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="Markdown" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource EditorForeground}"/>
                <TextBox x:Name="MarkdownEditor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="8"
                         Background="{DynamicResource EditorBackground}"
                         Foreground="{DynamicResource EditorForeground}"
                         CaretBrush="{DynamicResource EditorForeground}"
                         TextChanged="MarkdownEditor_TextChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <DockPanel Grid.Column="2" Margin="4">
                <TabControl x:Name="RightTabs">
                    <TabItem Header="Preview">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <WebBrowser x:Name="HtmlPreview"/>
                        </Border>
                    </TabItem>
                    <TabItem Header="HTML Code">
                        <TextBox x:Name="HtmlCodeEditor"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Padding="8"
                                 Background="{DynamicResource EditorBackground}"
                                 Foreground="{DynamicResource EditorForeground}"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
