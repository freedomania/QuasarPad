<Window x:Class="QuasarPad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - QuasarPad"
        Height="420" Width="480"
        MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0" Padding="8,6" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Padding="8,6" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,10"/>

                <CheckBox x:Name="ChkDarkMode" Content="Dark Mode" Margin="0,0,0,8"
                          Foreground="{DynamicResource EditorForeground}"/>
                <CheckBox x:Name="ChkPureMode" Content="Pure Mode (minimal UI)" Margin="0,0,0,8"
                          Foreground="{DynamicResource EditorForeground}"/>
                <CheckBox x:Name="ChkWordWrap" Content="Word Wrap" Margin="0,0,0,8"
                          Foreground="{DynamicResource EditorForeground}"/>
                <CheckBox x:Name="ChkStatusBar" Content="Show Status Bar" Margin="0,0,0,16"
                          Foreground="{DynamicResource EditorForeground}"/>

                <TextBlock Text="Editor" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,10"/>

                <TextBlock Text="Font Family" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbFont" Margin="0,0,0,10" Height="28">
                    <ComboBoxItem>Consolas</ComboBoxItem>
                    <ComboBoxItem>Cascadia Mono</ComboBoxItem>
                    <ComboBoxItem>Courier New</ComboBoxItem>
                    <ComboBoxItem>Segoe UI</ComboBoxItem>
                    <ComboBoxItem>Tahoma</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Font Size" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Slider x:Name="SliderFontSize" Minimum="10" Maximum="28" Width="220" VerticalAlignment="Center"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged"/>
                    <TextBlock x:Name="TxtFontSize" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource EditorForeground}"/>
                </StackPanel>

                <TextBlock FontSize="12" Opacity="0.7"
                           Foreground="{DynamicResource EditorForeground}"
                           TextWrapping="Wrap"
                           Text="Settings are stored in %AppData%\QuasarPad\settings.json and load automatically next time."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
