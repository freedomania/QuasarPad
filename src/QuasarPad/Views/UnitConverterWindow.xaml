<Window x:Class="QuasarPad.Views.UnitConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit Converter - QuasarPad" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
  <StackPanel Margin="16">
    <TextBlock Text="Category" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
    <ComboBox x:Name="CmbCategory" Height="28" Margin="0,0,0,10" SelectionChanged="Category_Changed">
      <ComboBoxItem Content="Temperature" IsSelected="True"/>
      <ComboBoxItem Content="Length"/>
      <ComboBoxItem Content="Weight"/>
      <ComboBoxItem Content="Data size"/>
    </ComboBox>
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="From" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbFrom" Height="28" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtValue" Height="28" FontFamily="Consolas" Text="0"
                 Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="To" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbTo" Height="28" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtResult" Height="28" FontFamily="Consolas" IsReadOnly="True"
                 Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal">
      <Button Content="Convert" Padding="14,6" Margin="0,0,8,0" Click="Convert_Click" IsDefault="True"/>
      <Button Content="Copy result" Padding="14,6" Click="Copy_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
