<Window x:Class="QuasarPad.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diff - QuasarPad" Height="600" Width="900"
        MinHeight="400" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Compare" Padding="12,4" Click="Compare_Click" Margin="0,0,8,0"/>
      <Button Content="Copy Result" Padding="12,4" Click="Copy_Click"/>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="Text A" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
          <TextBox x:Name="BoxA" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" Background="{DynamicResource EditorBackground}"
                   Foreground="{DynamicResource EditorForeground}"/>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="Text B" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
          <TextBox x:Name="BoxB" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" Background="{DynamicResource EditorBackground}"
                   Foreground="{DynamicResource EditorForeground}"/>
        </DockPanel>
      </Grid>
      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Diff (- removed / + added)" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
        <TextBox x:Name="ResultBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" Background="{DynamicResource EditorBackground}"
                 Foreground="{DynamicResource EditorForeground}"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
