<Window x:Class="QuasarPad.Views.ColorToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Tools - QuasarPad" Height="580" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Click a swatch for HEX / RGB (offline palette)" FontWeight="SemiBold"
               Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,8"/>
    <ScrollViewer DockPanel.Dock="Top" Height="280" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
      <UniformGrid x:Name="PaletteGrid" Columns="10"/>
    </ScrollViewer>
    <StackPanel>
      <TextBlock Text="HEX" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
      <TextBox x:Name="TxtHex" Height="28" FontFamily="Consolas" Text="#007ACC" Margin="0,0,0,8"
               Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
      <TextBlock Text="RGB" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox x:Name="TxtR" Width="70" Height="28" Margin="0,0,8,0" FontFamily="Consolas"
                 Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
        <TextBox x:Name="TxtG" Width="70" Height="28" Margin="0,0,8,0" FontFamily="Consolas"
                 Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
        <TextBox x:Name="TxtB" Width="70" Height="28" FontFamily="Consolas"
                 Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
      </StackPanel>
      <Border x:Name="Preview" Height="36" Margin="0,0,0,10" BorderThickness="1" BorderBrush="Gray"/>
      <TextBlock x:Name="TxtName" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="HEX → RGB" Padding="10,6" Margin="0,0,8,0" Click="HexToRgb_Click"/>
        <Button Content="RGB → HEX" Padding="10,6" Margin="0,0,8,0" Click="RgbToHex_Click"/>
        <Button Content="Copy HEX" Padding="10,6" Margin="0,0,8,0" Click="CopyHex_Click"/>
        <Button Content="Copy RGB" Padding="10,6" Click="CopyRgb_Click"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
