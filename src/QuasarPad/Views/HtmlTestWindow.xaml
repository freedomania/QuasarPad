<Window x:Class="QuasarPad.Views.HtmlTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HTML Test - QuasarPad"
        Height="650" Width="1000"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}">
            <Button Content="Refresh Preview" Click="Refresh_Click" Margin="4" Padding="10,4"/>
            <Button Content="Copy HTML" Click="Copy_Click" Margin="4" Padding="10,4"/>
            <Button Content="Load from Editor" Click="LoadFromEditor_Click" Margin="4" Padding="10,4"/>
            <Button Content="Clear" Click="Clear_Click" Margin="4" Padding="10,4"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="HTML Code" FontWeight="SemiBold"
                           Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
                <TextBox x:Name="HtmlEditor"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Padding="8"
                         Background="{DynamicResource EditorBackground}"
                         Foreground="{DynamicResource EditorForeground}"
                         CaretBrush="{DynamicResource EditorForeground}"
                         TextChanged="HtmlEditor_TextChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <DockPanel Grid.Column="2" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold"
                           Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <WebBrowser x:Name="PreviewBrowser"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
