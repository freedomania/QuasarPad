<Window x:Class="QuasarPad.Views.UrlShortenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URL Shortener - QuasarPad" Height="260" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
  <StackPanel Margin="16">
    <TextBlock Text="Long URL" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
    <TextBox x:Name="TxtUrl" Height="28" FontFamily="Consolas" Margin="0,0,0,10"
             Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
    <TextBlock Text="Short URL (needs internet — uses TinyURL)" Foreground="{DynamicResource EditorForeground}" Margin="0,0,0,4"/>
    <TextBox x:Name="TxtShort" Height="28" FontFamily="Consolas" IsReadOnly="True" Margin="0,0,0,10"
             Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"/>
    <StackPanel Orientation="Horizontal">
      <Button x:Name="BtnShorten" Content="Shorten" Padding="14,6" Margin="0,0,8,0" Click="Shorten_Click"/>
      <Button Content="Copy" Padding="14,6" Click="Copy_Click"/>
    </StackPanel>
    <TextBlock Margin="0,12,0,0" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
               Foreground="{DynamicResource EditorForeground}"
               Text="Note: Real URL shortening needs an online service. Offline-only apps cannot create public short links."/>
  </StackPanel>
</Window>
